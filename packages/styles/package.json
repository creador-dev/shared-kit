{
  "name": "@creador-dev/styles",
  "version": "0.1.0",
  "description": "Shared CSS tokens, reset, and utilities",
  "sideEffects": ["**/*.css"],
  "files": ["src"],
  "exports": {
    ".": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./reset.css": "./src/reset.css",
    "./utilities.css": "./src/utilities.css"
  },
  "scripts": {
    "build": "node -e \"console.log('CSS package is source-distributed')\""
  },
  "publishConfig": {
    "access": "public"
  }
}
