{
  "name": "@creador-dev/shared-kit",
  "version": "0.2.0",
  "description": "Complete collection of reusable Creador frontend packages",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/use-debounced-value": {
      "types": "./dist/hooks/use-debounced-value.d.ts",
      "import": "./dist/hooks/use-debounced-value.js"
    },
    "./hooks/use-media-query": {
      "types": "./dist/hooks/use-media-query.d.ts",
      "import": "./dist/hooks/use-media-query.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/clamp": {
      "types": "./dist/utils/clamp.d.ts",
      "import": "./dist/utils/clamp.js"
    },
    "./utils/cn": {
      "types": "./dist/utils/cn.d.ts",
      "import": "./dist/utils/cn.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/components/*.ts src/hooks/index.ts src/hooks/use-debounced-value.ts src/hooks/use-media-query.ts src/utils/index.ts src/utils/clamp.ts src/utils/cn.ts --format esm --dts --sourcemap --clean --external react",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@creador-dev/components": "workspace:^",
    "@creador-dev/hooks": "workspace:^",
    "@creador-dev/styles": "workspace:^",
    "@creador-dev/utils": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
