{
  "name": "@wpxdev/styles",
  "version": "0.2.1",
  "description": "Shared SCSS tokens, reset, and global utilities",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./utilities.css": "./dist/utilities.css",
    "./index.scss": "./src/index.scss",
    "./tokens.scss": "./src/tokens.scss",
    "./reset.scss": "./src/reset.scss",
    "./utilities.scss": "./src/utilities.scss"
  },
  "scripts": {
    "build": "sass src:dist --no-error-css --style=compressed --source-map",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
