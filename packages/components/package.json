{
  "name": "@creador-dev/components",
  "version": "0.1.0",
  "description": "Accessible, reusable React UI primitives",
  "type": "module",
  "sideEffects": [
    "**/*.scss"
  ],
  "files": ["dist", "src/**/*.scss"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.scss": "./src/styles.scss"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
